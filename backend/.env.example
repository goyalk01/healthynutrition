# ===================================
# NutriSense Backend Environment
# ===================================

NODE_ENV=development
APP_MODE=development
APP_NAME=nutrisense-api
HOST=0.0.0.0
PORT=8080
SHUTDOWN_TIMEOUT_MS=10000

# Database (PostgreSQL)
DATABASE_URL="postgresql://nutrisense:password@localhost:5432/nutrisense_db?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT Secrets (generate with: openssl rand -hex 32)
JWT_ACCESS_SECRET=<generate-64-char-hex-string>
JWT_REFRESH_SECRET=<generate-64-char-hex-string>

# JWT Expiry
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS (comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:3000

# Security
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000

# Request Body Limit (bytes, default: 1 MB)
MAX_BODY_SIZE=1048576
