datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  avatarUrl     String?
  age           Int?
  weight        Float?    // kg
  height        Float?    // cm
  activityLevel String    @default("MODERATE")
  goal          String    @default("MAINTAIN")
  dailyCalorieTarget Int?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  meals         Meal[]
  habits        Habit[]
  habitLogs     HabitLog[]
  mealLogs      MealLog[]
  refreshTokens RefreshToken[]
  recommendations Recommendation[]
  userPreferences UserPreference?

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  isRevoked Boolean  @default(false)

  @@map("refresh_tokens")
  @@index([userId, isRevoked, expiresAt])
  @@index([userId, token])
}

model Meal {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  calories     Float
  protein      Float    // grams
  carbs        Float    // grams
  fat          Float    // grams
  fiber        Float?
  sugar        Float?
  mealType     String   // BREAKFAST | LUNCH | DINNER | SNACK | PRE_WORKOUT | POST_WORKOUT
  imageUrl     String?
  tags         String[] @default([])
  isCustom     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  logs         MealLog[]

  @@index([userId, createdAt])
  @@index([userId, mealType, createdAt])
  @@index([userId, name])
  @@map("meals")
}

model MealLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealId    String
  meal      Meal     @relation(fields: [mealId], references: [id])
  loggedAt  DateTime @default(now())
  quantity  Float    @default(1.0)  // multiplier
  mood      String?  // GREAT | GOOD | NEUTRAL | BAD | TERRIBLE
  energyLevel Int?   // 1-10

  @@index([userId, loggedAt])
  @@index([userId, mealId, loggedAt])
  @@index([mealId, loggedAt])
  @@map("meal_logs")
}

model Habit {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  category    String   // HYDRATION | SLEEP | EXERCISE | NUTRITION | MINDFULNESS
  frequency   String   // DAILY | WEEKLY
  targetCount Int      @default(1)
  unit        String?  // e.g., "glasses", "minutes"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  logs        HabitLog[]

  @@map("habits")
  @@index([userId, isActive, createdAt])
  @@index([userId, category])
}

model HabitLog {
  id        String   @id @default(cuid())
  habitId   String
  habit     Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  loggedAt  DateTime @default(now())
  count     Int      @default(1)
  note      String?

  @@index([userId, loggedAt])
  @@index([userId, habitId, loggedAt])
  @@index([habitId, loggedAt])
  @@map("habit_logs")
}

model Recommendation {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String   // MEAL | HABIT | INSIGHT | ALERT
  title       String
  description String
  data        String   @default("{}") // JSON stored as text
  score       Float    // confidence 0-1
  isRead      Boolean  @default(false)
  isSaved     Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, isRead, createdAt])
  @@index([userId, type, createdAt])
  @@map("recommendations")
}

model UserPreference {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dietaryRestrictions String[] @default([])
  allergies           String[] @default([])
  cuisinePrefs        String[] @default([])
  dislikedFoods       String[] @default([])
  updatedAt           DateTime @updatedAt

  @@map("user_preferences")
}
